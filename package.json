{
  "name": "@stead/pi-tools",
  "version": "0.1.0",
  "description": "Focused Pi extensions for file-link footnotes, deferred prompts, and structured compaction",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edhor1608/pi-tools.git"
  },
  "homepage": "https://github.com/edhor1608/pi-tools#readme",
  "bugs": {
    "url": "https://github.com/edhor1608/pi-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "stead",
    "context",
    "compaction",
    "workflow",
    "stash",
    "file-links",
    "footnotes",
    "rendering"
  ],
  "files": [
    "extensions",
    "defaults",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "bun run typecheck && bun run test:file-footnotes && bun run test:stash-release && bun run test:structured-compaction",
    "analyze": "bun ./scripts/analyze-session.ts",
    "test:stash-release": "bun ./scripts/test-stash-release.ts",
    "test:file-footnotes": "bun ./scripts/test-file-footnotes.ts",
    "test:structured-compaction": "bun ./scripts/test-structured-compaction.ts",
    "test:packaged-defaults-fallback": "bun ./scripts/test-packaged-defaults-fallback.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.82.1 <0.83.0",
    "@earendil-works/pi-ai": ">=0.82.1 <0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.82.1 <0.83.0",
    "@earendil-works/pi-tui": ">=0.82.1 <0.83.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/file-footnotes.ts",
      "./extensions/stash.ts",
      "./extensions/structured-compaction/index.ts"
    ]
  }
}
