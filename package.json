{
	"name": "@stead/pi-tools",
	"version": "0.1.0",
	"description": "Focused Pi extensions for subagents, statusline, file-link footnotes, deferred prompts, and structured compaction",
	"keywords": [
		"claude",
		"compaction",
		"context",
		"file-links",
		"footnotes",
		"pi",
		"pi-package",
		"rendering",
		"stash",
		"statusline",
		"stead",
		"subagents",
		"workflow"
	],
	"homepage": "https://github.com/edhor1608/pi-tools#readme",
	"bugs": {
		"url": "https://github.com/edhor1608/pi-tools/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/edhor1608/pi-tools.git"
	},
	"files": [
		"extensions",
		"defaults",
		"skills",
		"scripts",
		"docs",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "echo 'nothing to clean'",
		"build": "echo 'nothing to build'",
		"format": "oxfmt extensions scripts package.json tsconfig.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json",
		"format:check": "oxfmt --check extensions scripts package.json tsconfig.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json",
		"lint": "oxlint --deny-warnings .",
		"test": "node --test scripts/*.test.ts extensions/*/*.test.ts",
		"test:live": "node --test extensions/subagents/*.live.ts",
		"test:live:claude": "node --test extensions/subagents/claude.live.ts",
		"test:live:pi": "node --test extensions/subagents/pi.live.ts",
		"check": "pnpm run format:check && pnpm run lint && pnpm test",
		"analyze": "node ./scripts/analyze-session.ts",
		"test:stash-release": "node --test scripts/stash-release.test.ts",
		"test:file-footnotes": "node --test scripts/file-footnotes.test.ts",
		"test:structured-compaction": "node --test scripts/structured-compaction.test.ts",
		"test:packaged-defaults-fallback": "node --test scripts/packaged-defaults-fallback.test.ts"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.220",
		"@anthropic-ai/sdk": "0.115.0",
		"effect": "4.0.0-beta.102",
		"typebox": "1.3.8"
	},
	"devDependencies": {
		"@types/node": "26.1.2",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.82.1 <0.83.0",
		"@earendil-works/pi-ai": ">=0.82.1 <0.83.0",
		"@earendil-works/pi-coding-agent": ">=0.82.1 <0.83.0",
		"@earendil-works/pi-tui": ">=0.82.1 <0.83.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@11.9.0",
	"pi": {
		"extensions": [
			"./extensions/file-footnotes.ts",
			"./extensions/subagents/index.ts",
			"./extensions/stash.ts",
			"./extensions/statusline.ts",
			"./extensions/structured-compaction/index.ts"
		],
		"skills": [
			"./skills/subagents"
		]
	}
}
